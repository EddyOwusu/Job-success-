# Copy to .env and fill in. Everything is optional except where noted.

# Claude API - powers deep fit assessment, CV tailoring, cover letters, form answers
# and outreach messages. Without it the agent still searches, scores and builds
# keyword-tailored CVs, but with much less quality.
ANTHROPIC_API_KEY=

# Reed.co.uk API (free): https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Adzuna API (free): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Hunter.io (optional, free tier): finds recruiter / hiring manager emails by company domain
HUNTER_API_KEY=

# Notifications (any combination)
# ntfy.sh push to your phone: install the ntfy app and subscribe to a hard-to-guess topic name
NTFY_TOPIC=
# Telegram bot: create with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email digest via SMTP (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Inbox reading (replies to your applications). Defaults to the SMTP login above.
# Gmail: turn on IMAP in Gmail settings and use the same App Password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
